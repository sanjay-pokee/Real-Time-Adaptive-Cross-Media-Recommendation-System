{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "cwd": "frontend",
      "port": 4173,
      "autoPort": false
    },
    {
      "name": "frontend-demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        "dist-demo",
        "--port",
        "4174",
        "--strictPort"
      ],
      "cwd": "frontend",
      "port": 4174,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-X",
        "faulthandler",
        "-m",
        "uvicorn",
        "backend.app:app",
        "--port",
        "8000"
      ],
      "port": 8000,
      "autoPort": false
    }
  ]
}
