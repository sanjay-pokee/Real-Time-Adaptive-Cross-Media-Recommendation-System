QDRANT_PATH=qdrant_storage
﻿QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=content
QDRANT_API_KEY=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=cross_media_recs

TMDB_API_KEY=your_tmdb_api_key
MUSICBRAINZ_USER_AGENT=cross-media-recommender/0.1 (your-email@example.com)

# Album artwork for the music catalogue (scripts.backfill_cover_art --provider spotify).
# Free app registration at https://developer.spotify.com/dashboard - no review needed.
# Only used to read public album image URLs for display.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Album artwork for music (scripts.backfill_cover_art --provider lastfm).
# Free key, instant: https://www.last.fm/api/account/create
# Only used to read public album image URLs for display.
LASTFM_API_KEY=
